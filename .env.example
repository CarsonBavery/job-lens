# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---
# Project Settings > API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Stripe ---
# https://dashboard.stripe.com/apikeys (use test keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs for the paid tier, created in the Stripe dashboard
STRIPE_PRICE_ID_PRO_MONTHLY=

# --- Job ingestion cron (Phase 3) ---
# Any random string; Vercel Cron sends it as "Authorization: Bearer <value>".
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
